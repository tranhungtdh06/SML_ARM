  <!-- Imported from arm_assembly_2.urdf (Onshape) with simplified collision meshes from ARM_collision -->
  <xacro:macro name="sml_arm_description" params="prefix:='' parent:='world' fast_visual:=false">

    <!-- Base attachment so base_link bottom (Z=-0.15m) rests on ground plane and J1 is centered at (0,0) -->
    <joint name="${prefix}base_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}base_link"/>
      <origin xyz="0.204085 0 0.15" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}base_link">
